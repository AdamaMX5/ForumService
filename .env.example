# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/forum-service

# Auth (JWT-Public-Key wird ausschliesslich zur Laufzeit von hier geladen, niemals aus .env)
AUTH_SERVICE_URL=https://auth.freischule.info

# Andere Microservices
EMAIL_SERVICE_URL=https://email.freischule.info
PROFILE_SERVICE_URL=https://profile.freischule.info
MEDIA_SERVICE_URL=https://media.freischule.info

# Interner API-Key, mit dem ForumService sich bei anderen Services ausweist (X-API-Key)
INTERNAL_API_KEY=

# Rate limiting (Requests pro Fenster, siehe Abschnitt 14 der Spec)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
