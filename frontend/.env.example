# ForumService API-Basis-URL (das Backend in diesem Repo, src/)
VITE_FORUM_API_URL=http://localhost:3000

# AuthService fuer Login/Register/Refresh (siehe .claude/MSArchitecture/AuthService.md)
VITE_AUTH_SERVICE_URL=https://auth.freischule.info

# GitService fuer die "Idee/Bug melden"-Funktion (Glühbirnen-Icon im Kommentare-Popup) -
# erstellt Issues ueber POST /issue (siehe .claude/MSArchitecture/GitService.md)
VITE_GIT_SERVICE_URL=https://git.freischule.info
VITE_GIT_SERVICE_REPO=ForumService

# true = MSW-Mocks statt echter Netzwerkaufrufe verwenden (fuer lokale UI-Entwicklung/Demo
# ohne laufendes Backend/AuthService). Niemals in Produktion setzen.
VITE_USE_MOCKS=false
