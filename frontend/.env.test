# Used only by Vitest (mode "test") so src/auth/authClient.ts has a configured
# VITE_AUTH_SERVICE_URL without every test needing to stub import.meta.env by hand.
VITE_FORUM_API_URL=http://localhost:3000
VITE_AUTH_SERVICE_URL=http://localhost:4000
VITE_GIT_SERVICE_URL=http://localhost:5000
VITE_GIT_SERVICE_REPO=ForumService
VITE_USE_MOCKS=false
